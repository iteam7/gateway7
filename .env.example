# Copy to .env, fill the two required values, then run:
# docker compose up --build --detach --wait
# Compose reads .env; Gateway7 itself reads only process variables.
COMPOSE_FILE=compose.yaml:compose.live.yaml
COMPOSE_PATH_SEPARATOR=:
GATEWAY_CONFIG_FILE=./config/openai.yaml
GATEWAY_KEY_ENV=OPENAI_API_KEY

# Required: your OpenAI API key, kept on the gateway server.
OPENAI_API_KEY=
# Required: a different random client token (16–512 visible ASCII characters,
# without spaces). Create it in your password manager; never reuse the API key.
GATEWAY7_CLIENT_TOKEN=

# PostgreSQL-backed admin console: use COMPOSE_FILE=compose.yaml:compose.admin.yaml
# and GATEWAY_CONFIG_FILE=./config/admin-postgres.yaml. Set a random database
# password and a separate recovery operator token. In /operator/console use that
# token once to create a password administrator, then use ordinary password sign-in.
# Browser sessions use HTTPS/Secure cookies by default; session lifetimes and the
# explicit direct-loopback HTTP exception are server YAML, not environment flags.
GATEWAY7_OPERATOR_TOKEN=
# Optional until a provider credential is saved through the console. A private
# Fernet key encrypts that write-only credential; keep it separately from backups.
GATEWAY7_CONTROL_KEY=
GATEWAY7_POSTGRES_PASSWORD=
# Optional DSN override; the Compose default is postgresql://gateway7@postgres:5432/gateway7.
# The password is passed separately as PGPASSWORD, so it needs no URI escaping.
GATEWAY7_DATABASE_URL=
# Optional local SQLite mode uses compose.admin-sqlite.yaml and a private directory
# prepared for UID/GID 10001:10001; see docs/authentication.md.
GATEWAY7_ADMIN_STATE_DIR=
# Optional operator-created HTTPS override: private certificate/config directory
# outside the checkout. See the local HTTPS recipe in docs/authentication.md.
GATEWAY7_CONSOLE_TLS_DIR=

# Optional: set only after configuring an explicit proxy transport in YAML.
# See docs/provider-transports.md; a URL alone does not enable a proxy.
GATEWAY7_PROXY_URL=

# Optional: push each request's log point and the SLI-01 histogram to the
# environment's OpenObserve organization. Leave disabled on a developer machine.
# See docs/observability.md and docs/deployment.md#telemetry-pipelines.
TELEMETRY_ENABLED=false
# staging or production; required when telemetry or analytics is enabled.
GATEWAY7_ENVIRONMENT=
# The organization's OTLP base, such as <OpenObserve address>/api/staging.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 of the ingestion user:token>,stream-name=gateway7_requests
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: product events to the environment's separate OpenPanel project.
# The server chooses source; clients cannot override it with a header.
# Production requires web. Use smoke only in staging, then restore web.
ANALYTICS_ENABLED=false
ANALYTICS_SOURCE=web
# Self-hosted API base (including /api when the reverse proxy uses that prefix).
OPENPANEL_API_URL=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# TLS proxy operator settings; set privately on the VM, not in a gateway env file.
TELEMETRY_BIND_ADDRESS=
TELEMETRY_TLS_DIR=
# Optional overrides if the backend Compose projects use different network names.
ANALYTICS_BACKEND_NETWORK=
OBSERVABILITY_BACKEND_NETWORK=

# For Claude or Gemini, change the two GATEWAY selectors and add the matching
# provider key variable. See docs/setup.md#real-providers for examples.
# Shell variables override these values. Single-quote values containing $ or #.
# Keep .env local; do not commit it.
