# The gateway reads process variables, not .env files. Docker Compose has its
# own .env behavior. Keep real values in private secret injection or ignored .env.
# These two values are public fixtures for the legacy manual fake upstream.
FAKE_LLM_API_KEY=gateway7-synthetic-demo-only
DEMO_PROVIDER_KEY=gateway7-synthetic-demo-only
# Supply only the selected provider credential privately.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# A distinct private gateway client token, required by the real-provider samples.
GATEWAY7_CLIENT_TOKEN=
# Client-side variable read by gateway7 chat; use the server-issued client token.
GATEWAY7_TOKEN=
# Live Compose also needs GATEWAY_CONFIG_FILE and GATEWAY_KEY_ENV to select the
# matching config file and provider credential variable; see docs/setup.md.
