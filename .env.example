# Copy to .env, fill the two required values, then run:
# docker compose up --build --detach --wait
# Compose reads .env; Gateway7 itself reads only process variables.
COMPOSE_FILE=compose.yaml:compose.live.yaml
COMPOSE_PATH_SEPARATOR=:
GATEWAY_CONFIG_FILE=./config/openai.yaml
GATEWAY_KEY_ENV=OPENAI_API_KEY

# Required: your OpenAI API key, kept on the gateway server.
OPENAI_API_KEY=
# Required: a different random client token (16–512 visible ASCII characters,
# without spaces). Create it in your password manager; never reuse the API key.
GATEWAY7_CLIENT_TOKEN=

# Optional: set only after configuring an explicit proxy transport in YAML.
# See docs/provider-transports.md; a URL alone does not enable a proxy.
GATEWAY7_PROXY_URL=

# Optional: push each request's log point and the SLI-01 histogram to the
# environment's OpenObserve organization. Leave disabled on a developer machine.
# See docs/observability.md and docs/deployment.md#telemetry-pipelines.
TELEMETRY_ENABLED=false
# staging or production; required when telemetry is enabled.
GATEWAY7_ENVIRONMENT=
# The organization's OTLP base, such as <OpenObserve address>/api/staging.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 of the ingestion user:token>,stream-name=gateway7_requests
OTEL_EXPORTER_OTLP_HEADERS=

# For Claude or Gemini, change the two GATEWAY selectors and add the matching
# provider key variable. See docs/setup.md#real-providers for examples.
# Shell variables override these values. Single-quote values containing $ or #.
# Keep .env local; do not commit it.
